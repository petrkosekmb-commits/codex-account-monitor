<Project>
  <Target Name="UseLocalSessionActivity" BeforeTargets="CoreCompile" Condition="'$(MSBuildProjectName)' == 'CodexSwitch.Protocol'">
    <ItemGroup>
      <Compile Remove="SessionActivity.cs;$(MSBuildProjectDirectory)/SessionActivity.cs" />
      <Compile Include="$(MSBuildThisFileDirectory)SessionActivity.cs" />
    </ItemGroup>
  </Target>
  <Target Name="UseLocalCredentialOwnership" BeforeTargets="CoreCompile" Condition="'$(MSBuildProjectName)' == 'CodexSwitch.Application'">
    <ItemGroup>
      <Compile Remove="AccountService.cs;$(MSBuildProjectDirectory)/AccountService.cs;Runtime.cs;$(MSBuildProjectDirectory)/Runtime.cs" />
      <Compile Include="$(MSBuildThisFileDirectory)AccountService.cs;$(MSBuildThisFileDirectory)SessionCredentialPolicy.cs;$(MSBuildThisFileDirectory)ActiveUsageClient.cs;$(MSBuildThisFileDirectory)InactiveUsageReader.cs;$(MSBuildThisFileDirectory)Runtime.cs" />
    </ItemGroup>
  </Target>
  <Target Name="UseLocalWindowsProcessInspection" BeforeTargets="CoreCompile" Condition="'$(MSBuildProjectName)' == 'CodexSwitch.DesktopClient'">
    <ItemGroup>
      <Compile Remove="RuntimeLocator.cs;$(MSBuildProjectDirectory)/RuntimeLocator.cs" />
      <Compile Include="$(MSBuildThisFileDirectory)RuntimeLocator.cs;$(MSBuildThisFileDirectory)WindowsProcessImage.cs" />
    </ItemGroup>
  </Target>
</Project>
