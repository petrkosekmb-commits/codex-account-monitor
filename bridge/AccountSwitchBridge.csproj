<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><OutputType>Exe</OutputType>
    <AssemblyName>CodexSwitch</AssemblyName><RootNamespace>AccountSwitchBridge</RootNamespace>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><Version>0.2.15</Version>
    <UpstreamRoot Condition="'$(UpstreamRoot)' == ''">$(MSBuildThisFileDirectory).upstream/codex-switch-1.41.1</UpstreamRoot>
  </PropertyGroup>
  <ItemGroup><Compile Remove="compat/**/*.cs;tests/**/*.cs;credential-tests/**/*.cs" /><ProjectReference Include="$(UpstreamRoot)/src/application/CodexSwitch.Application.csproj" /></ItemGroup>
</Project>
